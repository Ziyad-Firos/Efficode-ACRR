# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real keys.

# ── AI layer (set at least one to enable AI suggestions) ──────────────────

# Google Gemini free tier — get a key at https://aistudio.google.com/
GEMINI_API_KEY=

# OR: local Ollama instance (no API key needed, runs on your machine)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=codellama

# ── Optional tuning ───────────────────────────────────────────────────────

# Max seconds to wait for AI response (default: 15)
# AI_TIMEOUT=15

# Server host/port (uvicorn defaults — change if port 8000 is taken)
# HOST=0.0.0.0
# PORT=8000
